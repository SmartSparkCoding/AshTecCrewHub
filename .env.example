# Copy to .env and fill in. Never commit .env.

# Public base URL. No trailing slash. Used for magic links and email buttons.
APP_URL=http://localhost:8080

# Postgres. Local socket example (macOS Homebrew):
#   DATABASE_URL=postgres://USER@localhost/ashtec?host=/tmp
# Production example:
#   DATABASE_URL=postgres://crew:password@127.0.0.1:5432/ashtec
DATABASE_URL=
DATABASE_POOL_MAX=10

# Port the Express server listens on. Production target is 1502.
PORT=1502

# --- Email (SMTP) ---
# Leave SMTP_HOST/USER/PASSWORD unset in development: emails are then written to
# the server log instead of being sent, and the magic-link URL is printed there.
# In production set all three or sign-in links will never arrive.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=AshTec Crew <crew@ashtec.hackclub.app>